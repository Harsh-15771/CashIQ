# CashIQ Environment Configuration
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Extraction (Optional - CashIQ includes fallback deterministic extraction if key is omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Razorpay Integration (Test Mode / Sandbox)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_secret_for_dev_mode
RAZORPAY_WEBHOOK_SECRET=cashiq_webhook_secret_2026

# Operational Guardrails & Financial Policy Thresholds
EXTRACTION_CONFIDENCE_GATE=0.80
HIGH_VALUE_THRESHOLD_INR=250000.0
PROACTIVE_COOLDOWN_DAYS=4
HIGH_CREDIBILITY_PROB_THRESHOLD=0.70
LOW_CREDIBILITY_PROB_THRESHOLD=0.50
